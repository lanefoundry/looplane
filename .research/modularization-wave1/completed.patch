-        focus_provider: str | None = None,
-        credential_only: bool = False,
-    ) -> None:
-        super().__init__()
-        self.current = current
-        self.runtimes = tuple(runtimes)
-        self.providers = tuple(providers)
-        self.ollama_models = ollama_models
