(version 1)
(deny default)
(allow process*)
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read*
  (subpath "/Users/xiaoxu/Projects/looplane/.research/macos-sandbox-evidence/workspace")
  (subpath "/Users/xiaoxu/Projects/looplane/.venv")
  (subpath "/Users/xiaoxu/.local/share/uv/python/cpython-3.11.14-macos-aarch64-none")
  (subpath "/System")
  (subpath "/Library")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/private/var/folders")
  (subpath "/private/tmp")
  (subpath "/tmp")
)
(allow file-write*
  (subpath "/Users/xiaoxu/Projects/looplane/.research/macos-sandbox-evidence/workspace")
)
(allow file-read-metadata (literal "/"))
