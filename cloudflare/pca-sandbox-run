#!/bin/sh
set -eu

workspace=/workspace
token_file=/workspace/.pca-run-token

test "$(id -u)" -eq 0
test -d "$workspace/source"
test -f "$workspace/request.json"
test -f "$token_file"
test ! -L "$token_file"

chown -R pca:pca "$workspace"
chmod 0700 "$workspace"
chmod 0600 "$token_file"

exec setpriv \
  --reuid=pca \
  --regid=pca \
  --init-groups \
  --no-new-privs \
  env \
    HOME=/home/pca \
    PATH=/usr/local/bin:/usr/bin:/bin \
    PCA_MODEL_ID="$PCA_MODEL_ID" \
    PCA_MODEL_GATEWAY_URL="$PCA_MODEL_GATEWAY_URL" \
    PCA_MAX_BUNDLE_BYTES="$PCA_MAX_BUNDLE_BYTES" \
    python3 -m coding_agent.sandbox_entry /workspace/request.json
