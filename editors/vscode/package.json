{
  "name": "looplane-vscode",
  "displayName": "looplane",
  "description": "Push VS Code diagnostics and open-file context into looplane.",
  "version": "0.1.0",
  "publisher": "looplane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentxuu/looplane.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:looplane.pushIdeContext"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "looplane.pushIdeContext",
        "title": "looplane: Push IDE Context"
      }
    ],
    "configuration": {
      "title": "looplane",
      "properties": {
        "looplane.ideContext.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Push diagnostics and open files into .looplane/ide for looplane runs."
        },
        "looplane.ideContext.webSocketUrl": {
          "type": "string",
          "default": "",
          "description": "Optional looplane conversation WebSocket attach URL for direct IDE context push."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
