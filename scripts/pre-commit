#!/usr/bin/env bash
# Pre-commit hook: run ruff lint on staged Python files.
# Blocks commit if lint fails. Skippable with git commit --no-verify.
#
# Install: scripts/install-hooks

set -euo pipefail

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py' || true)
if [ -z "$STAGED_PY" ]; then
    exit 0
fi

echo "pre-commit: ruff check on staged files…"
if command -v uv >/dev/null 2>&1; then
    echo "$STAGED_PY" | xargs uv run ruff check
elif command -v ruff >/dev/null 2>&1; then
    echo "$STAGED_PY" | xargs ruff check
else
    echo "pre-commit: ruff not found, skipping lint"
    exit 0
fi

echo "pre-commit: lint passed ✓"
